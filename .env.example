# --- Composio (single integration layer for all external apps) ---
# Server-side only. Never expose to the client.
COMPOSIO_API_KEY=

# Composio "entity" that owns the connected accounts this app operates as.
# Defaults to "default" if unset.
COMPOSIO_ENTITY_ID=default

# Optional: pin specific connected-account IDs when a toolkit has more than
# one account linked (see Integrations screen for the ids Composio returns).
COMPOSIO_INSTAGRAM_ACCOUNT_ID=
COMPOSIO_EMAIL_PROVIDER=mailchimp
COMPOSIO_TIKTOK_ACCOUNT_ID=
COMPOSIO_YOUTUBE_ACCOUNT_ID=
COMPOSIO_PINTEREST_ACCOUNT_ID=
COMPOSIO_TWITTER_ACCOUNT_ID=

# --- AI content generation (hooks, captions, scripts, briefs) ---
ANTHROPIC_API_KEY=

# --- Database ---
# Relative to prisma/schema.prisma, so this resolves to prisma/dev.db.
DATABASE_URL="file:./dev.db"
